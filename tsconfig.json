{
  "include": ["apps/web/src", "packages/**/*.ts", "types/**/*.d.ts", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@pbgc/shared": ["packages/shared/src/index.ts"],
      "@pbgc/db": ["packages/db/src/index.ts"],
      "@pbgc/benefit-kernel": ["packages/engine/benefit-kernel/src/index.ts"],
      "@pbgc/date-resolution": ["packages/engine/date-resolution/src/index.ts"],
      "@pbgc/service-resolution": ["packages/engine/service-resolution/src/index.ts"],
      "@pbgc/compensation-resolution": ["packages/engine/compensation-resolution/src/index.ts"],
      "@pbgc/form-resolution": ["packages/engine/form-resolution/src/index.ts"],
      "@pbgc/v1-ve-output": ["packages/engine/v1-ve-output/src/index.ts"],
      "@pbgc/valuation-listings-output": ["packages/engine/valuation-listings-output/src/index.ts"]
    },
    "types": ["vitest/globals", "node"]
  }
}
